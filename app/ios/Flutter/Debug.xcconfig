#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"
// Runner imports the firebase_messaging module, whose public header pulls in the
// non-modular <Firebase/Firebase.h>. Allow it on the app target too, not just the pods.
CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES = YES
